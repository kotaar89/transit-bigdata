# Скопируйте в .env и при необходимости поменяйте
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
CLICKHOUSE_USER=transit
CLICKHOUSE_PASSWORD=transit
SIM_ROUTES=40          # число маршрутов в городе
SIM_SEED=42
STREAM_SPEED=30        # во сколько раз симулированное время быстрее реального
STREAM_START_HOUR=7    # с какого часа начинать «живой» день
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1536m
